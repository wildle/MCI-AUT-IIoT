---
config:
  theme: base
---
%% Quelle fuer images/transform_bottle.svg
%% Export: VS-Code-Mermaid-Extension oder mermaid.live -> SVG nach ../images/
flowchart LR
    subgraph IN["MQTT-Topics"]
        D1["dispenser_red"]
        D2["dispenser_blue"]
        D3["dispenser_green"]
        T["temperature"]
        W["final_weight"]
        G["ground_truth"]
    end
    JOIN{"Transform<br/>Schluessel: bottle"}
    ROW["Eine Zeile pro Flasche:<br/>bottle · fill_red · fill_blue · fill_green · temp · final_weight · is_cracked"]
    D1 --> JOIN
    D2 --> JOIN
    D3 --> JOIN
    T --> JOIN
    W --> JOIN
    G --> JOIN
    JOIN --> ROW

    classDef input stroke:#607D8B,fill:#ECEFF1,color:#263238,stroke-width:2px;
    classDef transform stroke:#6A1B9A,fill:#F1E5F8,color:#3A0A52,stroke-width:2px;
    classDef ziel stroke:#2E7D32,fill:#E6F4E6,color:#14401A,stroke-width:3px;

    class D1,D2,D3,T,W,G input;
    class JOIN transform;
    class ROW ziel;

    style IN stroke:#90A4AE,fill:#F5F7F8,color:#37474F;
